    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieHeartGold"
        android:layout_width="400dp"
        android:layout_height="400dp"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="parent"
