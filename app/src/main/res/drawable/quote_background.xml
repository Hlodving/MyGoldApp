<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Мягкий фон -->
    <solid android:color="#FAFAFA" />

    <!-- Очень мягкая, полупрозрачная обводка -->
    <stroke
        android:width="0.8dp"
        android:color="#40AAAAAA" /> <!-- Серый с прозрачностью -->

    <!-- Более округлённые углы -->
    <corners android:radius="16dp" />
</shape>
